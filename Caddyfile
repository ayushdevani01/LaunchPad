{
    admin off
}

*.{$BASE_DOMAIN} {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
        resolvers 1.1.1.1 1.0.0.1
    }
    encode gzip

    @api host api.{$BASE_DOMAIN}
    handle @api {
        reverse_proxy api-server:9000
    }

    @logs host logs.{$BASE_DOMAIN}
    handle @logs {
        reverse_proxy logs-service:9002
    }

    handle {
        reverse_proxy reverse-proxy:8000
    }
}
