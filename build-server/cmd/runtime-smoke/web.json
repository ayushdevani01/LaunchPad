{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Temporary IAM-only native Next.js Web Function for the LaunchPad comparison.",
  "Metadata": { "AWSToolsMetrics": { "AWSAgentToolkit": "aws-cloudformation@3" } },
  "Parameters": {
    "FunctionName": { "Type": "String", "AllowedPattern": "lp-runtime-smoke-[a-z0-9-]+" },
    "ArtifactBucket": { "Type": "String", "AllowedPattern": "[a-z0-9.-]+" },
    "CodeKey": { "Type": "String", "AllowedPattern": "__artifacts/web/.+\\.zip" },
    "RoleArn": { "Type": "String", "AllowedPattern": "arn:[a-z-]+:iam::[0-9]{12}:role/.+" }
  },
  "Resources": {
    "Web": {
      "Type": "AWS::Lambda::WebFunction",
      "Metadata": { "com.aws.cloudformation.Context": { "why": "Compare native HTTP with OpenNext on the same Node and CPU architecture", "must": ["Temporary test only"] } },
      "Properties": { "FunctionName": { "Ref": "FunctionName" } }
    },
    "Revision": {
      "Type": "AWS::Lambda::WebFunctionRevision", "DependsOn": "Web",
      "Metadata": { "com.aws.cloudformation.Context": { "why": "Immutable native standalone Next.js package", "must": ["Node 24", "ARM-compatible dependencies"] } },
      "Properties": {
        "FunctionName": { "Ref": "FunctionName" },
        "BuildConfig": { "CodeConfig": { "S3Object": { "Bucket": { "Ref": "ArtifactBucket" }, "Key": { "Ref": "CodeKey" } } }, "RuntimeConfig": { "Runtime": "nodejs24.x" } },
        "ServiceConfig": { "ExecutionRoleArn": { "Ref": "RoleArn" }, "TimeoutSeconds": 30, "MaxConcurrencyPerEnvironment": 8, "EnvironmentVariables": { "NODE_ENV": "production", "NEXT_TELEMETRY_DISABLED": "1" } }
      }
    },
    "Endpoint": {
      "Type": "AWS::Lambda::WebFunctionEndpoint", "DependsOn": "Web",
      "Metadata": { "com.aws.cloudformation.Context": { "why": "Bounded private benchmark traffic", "must": ["IAM authentication", "Two-environment limit", "Fixed revision"] } },
      "Properties": { "FunctionName": { "Ref": "FunctionName" }, "EndpointName": "smoke", "EndpointType": "HomeRegion", "AuthType": "IamAuth", "RevisionWeights": [{ "RevisionId": { "Fn::GetAtt": ["Revision", "RevisionId"] }, "Weight": 100 }], "ScalingConfig": { "MaxEnvironments": 2 }, "ThrottleConfig": { "RateLimit": 100 } }
    }
  },
  "Outputs": { "Domain": { "Description": "IAM-only test hostname", "Value": { "Fn::GetAtt": ["Endpoint", "DomainName"] } } }
}
