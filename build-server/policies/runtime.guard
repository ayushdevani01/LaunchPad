# LaunchPad-specific invariants in addition to the AWS managed S3 rules.
let urls = Resources.*[ Type == 'AWS::Lambda::Url' ]
rule lambda_origins_require_iam when %urls !empty {
    %urls.Properties.AuthType == 'AWS_IAM'
}

let web_endpoints = Resources.*[ Type == 'AWS::Lambda::WebFunctionEndpoint' ]
rule web_test_origins_require_iam when %web_endpoints !empty {
    %web_endpoints.Properties.AuthType == 'IamAuth'
    %web_endpoints.Properties.ScalingConfig.MaxEnvironments <= 2
}

let functions = Resources.*[ Type == 'AWS::Lambda::Function' ]
rule lambda_request_deadlines when %functions !empty {
    %functions.Properties.Timeout <= 30
}
